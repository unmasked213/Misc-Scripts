@echo off
:: Toggle any display between Landscape and Portrait (flipped).
:: Bypasses AMD Adrenalin via direct Windows API call.
set /p "D=Display number to rotate: "
if "%D%"=="" exit /b
powershell -ExecutionPolicy Bypass -Command "Add-Type -TypeDefinition ([Text.Encoding]::UTF8.GetString([Convert]::FromBase64String(''))); [DR]::Toggle(%D%)"
pause