{
  "manifest_version": 3,
  "name": "Media Downloader",
  "version": "1.5",
  "description": "Download images and videos from selected tabs",
  "permissions": [
    "tabs",
    "downloads",
    "storage",
    "activeTab",
    "scripting",
    "webRequest",
    "webNavigation",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["intercept.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_title": "Media Downloader"
  },
  "commands": {
    "download-selected-tabs": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Download media from selected tabs"
    },
    "download-current-tab": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Download media from current tab"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
