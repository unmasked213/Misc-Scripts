{
  "manifest_version": 3,
  "name": "Image Downloader",
  "version": "1.0",
  "description": "Download images from selected tabs with Ctrl+Shift+S",
  "permissions": [
    "tabs",
    "downloads",
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "download-selected-tabs": {
      "suggested_key": {
        "default": "Ctrl+Shift+S"
      },
      "description": "Download images from selected tabs"
    },
    "download-current-tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+D"
      },
      "description": "Download image from current tab"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_title": "Download images from selected tabs"
  }
}
